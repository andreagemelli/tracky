{
  "manifest_version": 3,
  "name": "Tracky",
  "version": "0.2",
  "description": "Tells the Tracky Mac app when an AI reply finishes: site, model and approximate tokens. Never the text.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://www.google.com/search*",
        "https://chat.qwen.ai/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://www.perplexity.ai/*",
        "https://grok.com/*",
        "https://www.kimi.com/*",
        "https://copilot.microsoft.com/*",
        "https://chat.z.ai/*",
        "https://huggingface.co/chat/*",
        "https://poe.com/*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "https://chat.qwen.ai/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://www.perplexity.ai/*",
        "https://grok.com/*",
        "https://www.kimi.com/*",
        "https://copilot.microsoft.com/*",
        "https://chat.z.ai/*",
        "https://huggingface.co/chat/*",
        "https://poe.com/*"
      ],
      "js": [
        "meter.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
