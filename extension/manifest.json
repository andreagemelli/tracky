{
  "manifest_version": 3,
  "name": "Tracky",
  "version": "0.1",
  "description": "Tells the Tracky Mac app when an AI reply finishes: site, model and approximate tokens. Never the text.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://gemini.google.com/*", "https://www.google.com/search*"],
    "js": ["content.js"]
  }]
}
